{
  "name": "create-rapid-stack",
  "version": "0.1.0",
  "description": "Single-command scaffolding tool for fullstack Next.js + Express + Prisma applications",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-rapid-stack": "./bin/index.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "bin",
    "src",
    "templates"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint bin/ src/ test/ && prettier --check bin/ src/ test/",
    "format": "prettier --write bin/ src/ test/"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.1",
    "inquirer": "^14.2.3",
    "ora": "^9.4.1",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "prettier": "^3.9.10"
  }
}
